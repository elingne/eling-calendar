{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eling-calendar",
  "main": "src/worker.js",
  "compatibility_date": "2025-10-14",
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "vars": {
    "OWNER_EMAIL": "ielingkk@gmail.com",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "eling-calendar",
    "database_id": "0b32f5cc-af60-493c-9b46-551e31af0518",
    "migrations_dir": "migrations"
  }]
}
