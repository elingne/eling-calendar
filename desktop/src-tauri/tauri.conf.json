{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "My Calendar",
  "version": "0.1.0",
  "identifier": "app.eling.calendar",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "My Calendar",
        "url": "index.html",
        "width": 1240,
        "height": 820,
        "minWidth": 260,
        "minHeight": 320,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Korean"]
      }
    }
  }
}
